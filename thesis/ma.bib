  doi = {10.1007/978-3-031-35930-9_4},
  abstract = {Challenge within video games is a necessary component, one from which many players derive the majority of entertainment from. To understand challenge better, we looked at and defined challenge in prior research as obstacles that impede progress. Players then need to overcome these obstacles using a variety of skills in order to be able to continue playing the game. Since we looked primarily at how the objects contributing to the challenge were designed, we did not look at how the challenge were ordered within a given environment. Therefore, in order to expand on the research into challenge, we now also look at how challenge is ordered within a given environment, since the order in which challenge is encountered can have a significant impact on how the player experiences the challenges within the game. We analyzed a large variety of games, and found 5 common level flow patterns within games. Using these flows, it will be easier for developers to construct compelling levels in games.},
  isbn = {978-3-031-35930-9},
