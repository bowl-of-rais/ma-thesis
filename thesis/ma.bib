@inproceedings{aversaPruningPreprocessingMethods2016,
  title = {Pruning and Preprocessing Methods for Inventory-Aware Pathfinding},
  booktitle = {2016 {{IEEE Conference}} on {{Computational Intelligence}} and {{Games}} ({{CIG}})},
