  booktitle = {2023 {{IEEE}} 18th {{Conference}} on {{Industrial Electronics}} and {{Applications}} ({{ICIEA}})},
  author = {Xie, Zongquan and Cheng, Lei and Li, Xiang and Chen, Xiuqi},
  year = 2023,
