views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "papers"
        - file.ext == "md"
    order:
      - file.name
      - tags
      - paper_title
  - type: list
    name: View
    filters:
      and:
        - file.folder == "papers"
        - file.name != "_overview.base"
    indentProperties: false
