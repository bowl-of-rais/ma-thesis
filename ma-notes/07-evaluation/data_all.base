formulas:
  s_sob_miro: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("07-evaluation/user-study-data")
    order:
      - file.name
      - p_id
      - date
      - group
      - s_used_miro
      - p_used_miro
      - miro_usage
      - s_iss_miro
      - s_tp_miro
      - s_fp_miro
      - s_iss_pixie
      - s_tp_pixie
      - s_fp_pixie
      - p_ans_miro
      - p_ans_pixie
      - p_right_miro
      - p_right_pixie
      - participant
      - s_sob_miro
      - s_sob_pixie
    sort:
      - property: file.name
        direction: ASC
      - property: s_iss_miro
        direction: DESC
      - property: participant
        direction: ASC
      - property: user_id
        direction: ASC
      - property: user-id
        direction: DESC
      - property: issues_correct_pixie
        direction: ASC
    columnSize:
      note.miro_usage: 142
      note.s_iss_miro: 97
      note.s_tp_miro: 97
      note.s_fp_miro: 99
      note.s_iss_pixie: 97
      note.s_tp_pixie: 93
      note.s_fp_pixie: 92
      note.p_ans_miro: 106
      note.p_ans_pixie: 110
      note.p_right_miro: 122
      note.p_right_pixie: 131
      note.participant: 104
      note.s_sob_miro: 108
      note.s_sob_pixie: 111
