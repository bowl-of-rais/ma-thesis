views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("07-evaluation/user-study-data")
    order:
      - file.name
      - p_id
      - date
      - group
      - p_answered_miro
      - p_answered_pixie
      - s_issues_miro
      - s_issues_pixie
      - participant
    sort:
      - property: user_id
        direction: ASC
      - property: user-id
        direction: DESC
      - property: issues_correct_pixie
        direction: ASC
    columnSize:
      note.p_answered_miro: 149
