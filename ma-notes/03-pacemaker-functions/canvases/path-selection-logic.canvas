			"id":"805a7325f7c60184",
			"type":"text",
			"text":"```js\nconst { nodes, edges } = useVueFlow()\n\nwatch(nodes, (newNodes) => {}, { deep: true})\nwatch(edges, (newEdges) => {}, { deep: true})\n\n```",
			"styleAttributes":{"border":"invisible"},
			"x":480,
